# Copy to .env and adjust. Never commit .env.

# --- App ---
ENVIRONMENT=local
DEBUG=true
# Any non-local ENVIRONMENT refuses to start with this placeholder or a key
# under 32 characters. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=interviewiq
POSTGRES_PASSWORD=interviewiq
POSTGRES_DB=interviewiq
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- LLM ---
# fake = offline deterministic (default). gemini = live; requires a key below.
LLM_PROVIDER=fake
# One free key, or a comma-separated pool to rotate around free-tier rate limits.
GEMINI_API_KEY=
GEMINI_API_KEYS=
# gemini-2.0-flash reports limit:0 on free keys and gemini-flash-latest has
# returned 503s; gemini-3.6-flash is the model this project has run on.
GEMINI_MODEL=gemini-3.6-flash

# --- Embeddings (RAG Phase 1) ---
# Separate from LLM_PROVIDER on purpose: the knowledge base is embedded once and
# every retrieval embeds a query, which is a very different cost profile from
# generation and wants a local model even when generation stays on Gemini.
#   auto   - pre-seam behaviour: hash when LLM_PROVIDER=fake, gemini otherwise.
#   hash   - deterministic bag-of-words. Offline, no download, no semantics.
#   local  - bge-small via fastembed. Free, offline, real semantics. Recommended.
#   gemini - the hosted embedding endpoint.
# EMBEDDING_PROVIDER=auto
#
# IMPORTANT: switching embedders requires recalibrating EVAL_COVERAGE_THRESHOLD.
# Cosine values are model-specific - under bge-small two unrelated texts still
# score ~0.44, where the hash embedder gives ~0.0, so a threshold tuned for one
# is meaningless for the other. Measure it, do not guess:
#     python -m app.cli recalibrate
# On the shipped golden set, local embeddings want ~0.65 rather than 0.55.
# EVAL_COVERAGE_THRESHOLD=0.55

# --- Voice answers (local speech-to-text) ---
# Candidates can speak an answer; faster-whisper transcribes it on the CPU (free,
# offline, no API key), they edit the draft, and it is graded like a typed one.
# Needs the `voice` extra (installed in the Docker images, with the model baked
# in). Off by default: with it off the interview page shows no microphone.
# VOICE_ENABLED=false
# WHISPER_MODEL=base.en           # small.en: more accurate, ~3x slower
# VOICE_MAX_SECONDS=180           # per recording; an answer can use several

# --- LLM resilience / budget (sensible defaults; override to tune) ---
# LLM_CACHE_TTL_SECONDS=86400
# LLM_RETRY_MAX_ATTEMPTS=2
# LLM_BREAKER_THRESHOLD=5
# USER_DAILY_TOKEN_BUDGET=200000

# --- Résumé upload (Phase 5) ---
# UPLOAD_DIR=uploads            # compose sets /data/uploads (a named volume)
# RESUME_MAX_BYTES=2097152      # 2 MB
# RESUME_MIN_TEXT_CHARS=40      # less extracted text = a scan; ask for a paste

# --- Integrity signals (Phase 5, advisory only) ---
# INTEGRITY_MIN_CHARS=120
# INTEGRITY_MIN_TYPED_SHARE=0.4
# INTEGRITY_MAX_CHARS_PER_SECOND=12

# --- Pipeline reliability (Phase 6) ---
# TASK_MAX_RETRIES=4                  # transient provider errors: 30s, 60s, 120s, 240s
# TASK_RETRY_BASE_SECONDS=30
# REAPER_CREATED_AFTER_MINUTES=10     # re-dispatch sessions stuck this long
# REAPER_EVALUATING_AFTER_MINUTES=30
